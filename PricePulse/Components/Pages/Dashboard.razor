@page "/"
@inject PriceService Prices
@inject ILogger<Dashboard> Logger
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Dashboard</PageTitle>

<div class="dashboard">
        <h1>Dashboard</h1>
        <p class="text-muted">U.S. national average prices, updated monthly from the Bureau of Labor Statistics via
            FRED.
        </p>

    @if (failed)
    {
        <p class="text-muted">Something went wrong loading prices. Please try again shortly.</p>
    }
    else if (!Prices.IsWarm)
    {
        <p class="text-muted">Prices are loading — check back in a moment.</p>
    }
    else if (cards is not null)
    {
    <div class="dashboard-categories">
        @foreach (var group in cards.GroupBy(c => c.Series.Category))
        {
            <section class="dashboard-category">
                <h2 class="h5 mb-3">@group.Key.Label()</h2>
                <div class="row g-3">
                    @foreach (var card in group)
                    {
                        <div class="col-12 col-sm-6 col-lg-4">
                            <a href="@($"series/{card.Series.Id}")" class="text-reset text-decoration-none">
                                <RadzenCard class="h-100 dashboard-card">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <div class="fw-semibold">@card.Series.Name</div>
                                            <div class="text-primary small">@card.Series.Units</div>
                                        </div>
                                        <SeriesIcon Icon="@card.Series.Icon" />
                                    </div>

                                    <div class="d-flex align-items-baseline justify-content-between mb-2">
                                        <span class="fw-semibold card-value">
                                            @(card.Latest is { } v ? Lens.FormatValue(v, PriceLens.Nominal, card.Series.Kind) : "—")
                                        </span>
                                        @if (card.YoyPercent is { } yoy)
                                        {
                                            <span class="small">
                                                <PercentChange Value="yoy" />
                                                <span class="text-muted">vs 1 yr ago</span>
                                            </span>
                                        }
                                    </div>

                                    @if (card.Spark.Count > 0)
                                    {
                                        <ApexChart TItem="LensPoint" Height="48" Options="@card.SparkOptions">
                                            <ApexPointSeries TItem="LensPoint" Items="@card.Spark" XValue="@(p => p.Date)"
                                                             YValue="@(p => p.Value)" SeriesType="SeriesType.Line" />
                                        </ApexChart>
                                    }
                                </RadzenCard>
                            </a>
                        </div>
                    }
                </div>
            </section>
        }
        </div>
    }
</div>

@code {
    private List<SeriesCard>? cards;
    private bool failed;

    // Each chart needs its own options instance — ApexCharts writes per-chart state into it.
    private static ApexChartOptions<LensPoint> MakeSparkOptions() => new()
    {
        Chart = new Chart { Sparkline = new ChartSparkline { Enabled = true } },
        Colors = new List<string> { ChartTheme.Primary },
        Stroke = new Stroke { Curve = Curve.Smooth, Width = 2 },
        Xaxis = new XAxis { Type = XAxisType.Datetime }
    };

    protected override void OnInitialized()
    {
        Prices.Changed += OnPricesChanged;
        BuildCards();
    }

    private void OnPricesChanged() => InvokeAsync(() =>
    {
        BuildCards();
        StateHasChanged();
    });

    public void Dispose() => Prices.Changed -= OnPricesChanged;

    private void BuildCards()
    {
        try
        {
            var catalog = Prices.GetSeries();
            var result = new List<SeriesCard>();

            foreach (var s in catalog)
            {
                var priced = Lens.Apply(PriceLens.Nominal, Prices.GetObservations(s.Id), reference: null);

                if (priced.Count == 0)
                {
                    result.Add(new SeriesCard(s, null, null, Array.Empty<LensPoint>(), MakeSparkOptions()));
                    continue;
                }

                var latest = priced[^1];
                var sparkCutoff = latest.Date.AddYears(-10);
                var spark = priced.Where(p => p.Date >= sparkCutoff).ToList();

                result.Add(new SeriesCard(s, latest.Value, Lens.PercentChangeOverYears(priced, 1), spark,
                    MakeSparkOptions()));
            }

            cards = result;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to build the dashboard.");
            failed = true;
        }
    }

    private record SeriesCard(Series Series, decimal? Latest, decimal? YoyPercent, IReadOnlyList<LensPoint> Spark,
        ApexChartOptions<LensPoint> SparkOptions);
}
