@page "/series/{Id}"
@inject PriceService Prices
@inject ILogger<SeriesDetail> Logger
@rendermode InteractiveServer

<PageTitle>@(series?.Name ?? "Series")</PageTitle>

@if (failed)
{
    <p class="text-muted">Something went wrong loading this series. Please try again shortly.</p>
}
else if (projections is null)
{
    <p>Loading…</p>
}
else if (series is null)
{
    <p>Unknown series '<strong>@Id</strong>'.</p>
}
else
{
    <h1>@series.Name</h1>
    <p class="text-primary mb-1">@series.Units</p>
    @if (kind == SeriesKind.PriceIndex)
    {
        <p class="text-muted small mb-3" style="max-width: 40rem;">
            A price index tracks how prices move relative to a baseline period (set to 100) — it's a level,
            not a dollar amount. A value of 300 means prices are 3× the baseline.
        </p>
    }
    else if (kind == SeriesKind.Indicator)
    {
        <p class="text-muted small mb-3" style="max-width: 40rem;">
            How much the economy produces for each hour worked. It's an index (100 = the baseline year),
            so rising means each hour of work creates more value than before.
        </p>
    }

    @if (Displayed.Count > 0)
    {
        @if (available.Count > 1)
        {
            <RadzenSelectBar @bind-Value="lens" @bind-Value:after="OnLensChanged" TValue="PriceLens" Size="ButtonSize.Small"
                             class="mb-3">
                <Items>
                    <RadzenSelectBarItem Text="@NominalLabel" Value="PriceLens.Nominal" />
                    @if (available.Contains(PriceLens.RealDollars))
                    {
                        <RadzenSelectBarItem Text="Inflation adjusted" Value="PriceLens.RealDollars" />
                    }
                    @if (available.Contains(PriceLens.TimePrice))
                    {
                        <RadzenSelectBarItem Text="Work-time" Value="PriceLens.TimePrice" />
                    }
                </Items>
            </RadzenSelectBar>
        }

        @if (LensHelp is not null)
        {
            <p class="text-muted small mb-3 d-flex align-items-center gap-1">
                <RadzenIcon Icon="info" Style="font-size: 1rem;" />@LensHelp
            </p>
        }

        @if (lens == PriceLens.TimePrice)
        {
            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="text-muted small">Your pay:</span>
                <RadzenNumeric TValue="decimal?" @bind-Value="customRate" Placeholder="@AvgWagePlaceholder" Style="width: 16rem;" />
                <RadzenSelectBar @bind-Value="rateIsSalary" TValue="bool" Size="ButtonSize.Small">
                    <Items>
                        <RadzenSelectBarItem Text="/ hr" Value="false" />
                        <RadzenSelectBarItem Text="/ yr" Value="true" />
                    </Items>
                </RadzenSelectBar>
            </div>
        }

        @if (HeadlineValue is not null)
        {
            <RadzenCard class="mb-4" style="max-width: 26rem;">
                <div class="text-muted">@HeadlineTitle</div>
                <div style="font-size: 2rem; font-weight: 600;">@HeadlineValue</div>
                <div class="text-muted">@HeadlineSubtitle</div>
                @if (ComparativeText is not null)
                {
                    <div class="text-muted small mt-2 fst-italic">@ComparativeText</div>
                }
            </RadzenCard>
        }

        <RadzenSelectBar @bind-Value="rangeYears" TValue="int" Size="ButtonSize.Small" class="mb-3">
            <Items>
                <RadzenSelectBarItem Text="Past year" Value="1" />
                <RadzenSelectBarItem Text="Last 10 years" Value="10" />
                <RadzenSelectBarItem Text="Last 50 years" Value="50" />
            </Items>
        </RadzenSelectBar>

        @if (Filtered.Count > 0)
        {
            <ApexChart TItem="LensPoint" @key="@($"{rangeYears}-{lens}")" Height="400" Options="@options">
                <ApexPointSeries TItem="LensPoint" Items="@Filtered" Name="@series.Name" XValue="@(p => p.Date)"
                                 YValue="@(p => p.Value)" SeriesType="SeriesType.Line" />
            </ApexChart>
        }
        else
        {
            <p class="text-muted">No data in the selected range.</p>
        }
    }
    else
    {
        <p>No observations available for this series.</p>
    }

    <p class="text-muted small mt-4">
        Source: <a href="@($"https://fred.stlouisfed.org/series/{series.Id}")" target="_blank" rel="noopener">FRED</a>
        (@series.Id).
    </p>
}

@code {
    [Parameter]
    public string Id { get; set; } = "";

    private Series? series;
    private SeriesKind kind;
    private IReadOnlyList<PriceLens> available = new[] { PriceLens.Nominal };
    private Dictionary<PriceLens, IReadOnlyList<LensPoint>>? projections;
    private decimal? latestNominal;
    private DateTime? latestNominalDate;
    private decimal? averageWage;
    private DateTime? baseMonth;
    private bool failed;
    private string? loadedId;

    private int rangeYears = 10;
    private PriceLens lens = PriceLens.Nominal;
    private decimal? customRate;
    private bool rateIsSalary;

    private const decimal HoursPerWorkYear = 2080m;

    private ApexChartOptions<LensPoint> options = BuildOptions(PriceLens.Nominal, SeriesKind.Price);

    private IReadOnlyList<LensPoint> Displayed =>
        projections is not null && projections.TryGetValue(lens, out var pts) ? pts : Array.Empty<LensPoint>();

    private IReadOnlyList<LensPoint> Filtered
    {
        get
        {
            var pts = Displayed;
            if (pts.Count == 0)
            {
                return Array.Empty<LensPoint>();
            }

            var cutoff = pts[^1].Date.AddYears(-rangeYears);
            return pts.Where(p => p.Date >= cutoff).ToList();
        }
    }

    // Custom rate → hourly (salary assumes a 2,080-hour work year).
    private decimal? HourlyWage =>
        customRate is { } r && r > 0 ? (rateIsSalary ? r / HoursPerWorkYear : r) : null;

    // Personalization affects only this headline number, never the curve.
    private bool Personalized => lens == PriceLens.TimePrice && HourlyWage is not null;

    private string NominalLabel => Lens.IsDollar(kind) ? "Dollars" : "Index";

    private string? HeadlineValue
    {
        get
        {
            if (Displayed.Count == 0)
            {
                return null;
            }

            if (Personalized && latestNominal is { } price)
            {
                return Lens.FormatWorkTime(Lens.TimePriceAt(price, HourlyWage!.Value));
            }

            return Lens.FormatValue(Displayed[^1].Value, lens, kind);
        }
    }

    private string HeadlineTitle => lens switch
    {
        PriceLens.RealDollars when Lens.IsDollar(kind) => $"Most recent, in {BaseMonthLabel} dollars",
        PriceLens.RealDollars => "Most recent, adjusted for inflation",
        PriceLens.TimePrice when Personalized => $"Most recent, {RateLabel}",
        PriceLens.TimePrice => "Most recent, average non-executive worker",
        _ => "Most recent"
    };

    private string HeadlineSubtitle
    {
        get
        {
            var date = Personalized ? latestNominalDate : Displayed[^1].Date;
            var when = date?.ToString("MMMM yyyy") ?? "";

            return lens == PriceLens.TimePrice && latestNominal is { } price
                ? $"{price:C2} · {when}"
                : when;
        }
    }

    // "Then → now" story across the selected range, phrased for the active lens.
    private string? ComparativeText
    {
        get
        {
            var pts = Filtered;
            if (pts.Count < 2)
            {
                return null;
            }

            var first = pts[0];
            var last = pts[^1];
            var firstYear = first.Date.Year;
            var lastYear = last.Date.Year;
            if (firstYear == lastYear)
            {
                return null; // range too short to be interesting
            }

            if (lens == PriceLens.TimePrice)
            {
                if (first.Value <= 0 || last.Value <= 0)
                {
                    return null;
                }

                var fw = Lens.FormatWorkTime(first.Value);
                var lw = Lens.FormatWorkTime(last.Value);
                return last.Value < first.Value
                    ? $"{fw} in {firstYear} → {lw} today — an hour of work buys {first.Value / last.Value:0.0}× more."
                    : $"{fw} in {firstYear} → {lw} today — it costs {last.Value / first.Value:0.0}× more of your time.";
            }

            if (first.Value == 0)
            {
                return null;
            }

            var f = Lens.FormatValue(first.Value, lens, kind);
            var l = Lens.FormatValue(last.Value, lens, kind);
            var ratio = last.Value / first.Value;
            var change = ratio >= 1
                ? $"{ratio:0.0}× {(lens == PriceLens.RealDollars ? "in real terms" : "higher")}"
                : $"down to {ratio * 100:0}% of the {firstYear} level";
            return $"{f} in {firstYear} → {l} today — {change}.";
        }
    }

    private string RateLabel =>
        rateIsSalary ? $"at {customRate:C0}/yr" : $"at {customRate:C2}/hr";

    private string AvgWagePlaceholder
    {
        get
        {
            if (averageWage is not { } w) return "average non-executive worker";
            return rateIsSalary ? $"avg non-executive: {w * HoursPerWorkYear:C0}" : $"avg non-executive: {w:C2}";
        }
    }

    // The period real-dollar values are expressed in: the latest CPI month, i.e. "today's dollars".
    private string BaseMonthLabel => baseMonth?.ToString("MMMM yyyy") ?? "today's";

    private string? LensHelp => lens switch
    {
        PriceLens.RealDollars when Lens.IsDollar(kind) =>
            $"Past prices restated in {BaseMonthLabel} dollars using CPI, so amounts compare like-for-like.",
        PriceLens.RealDollars =>
            "The index restated against overall inflation (CPI) — rising means it outpaced inflation, flat means it kept pace.",
        PriceLens.TimePrice =>
            "How long you'd work to afford it, at average non-executive pay — enter your pay to personalize.",
        _ => null
    };

    private void OnLensChanged() => options = BuildOptions(lens, kind);

    // Mirror the palette in wwwroot/app.css; the line takes on the active lens's color.
    private static string LensColor(PriceLens l) => l switch
    {
        PriceLens.RealDollars => "#3949ab", // --blue
        PriceLens.TimePrice => "#7c3aed",   // --purple
        _ => "#4f46e5"                       // --indigo (--primary)
    };

    private static ApexChartOptions<LensPoint> BuildOptions(PriceLens l, SeriesKind k) => new()
    {
        Chart = new Chart { Toolbar = new Toolbar { Show = false } },
        Colors = new List<string> { LensColor(l) },
        Stroke = new Stroke { Curve = Curve.Straight, Width = 2 },
        Xaxis = new XAxis { Type = XAxisType.Datetime },
        Yaxis = new List<YAxis>
        {
            new YAxis { Labels = new YAxisLabels { Formatter = Lens.AxisFormatter(l, k) } }
        },
        Tooltip = new ApexCharts.Tooltip { X = new TooltipX { Format = "MMM yyyy" } }
    };

    protected override void OnParametersSet()
    {
        if (Id == loadedId)
        {
            return;
        }

        loadedId = Id;
        series = null;
        projections = null;
        latestNominal = null;
        baseMonth = null;
        failed = false;

        try
        {
            var catalog = Prices.GetSeries();
            series = catalog.FirstOrDefault(s => s.Id == Id);
            kind = series?.Kind ?? SeriesKind.Price;
            available = Lens.LensesFor(kind);
            if (!available.Contains(lens))
            {
                lens = PriceLens.Nominal;
            }

            var nominal = Prices.GetObservations(Id);

            var proj = new Dictionary<PriceLens, IReadOnlyList<LensPoint>>
            {
                [PriceLens.Nominal] = Lens.Apply(PriceLens.Nominal, nominal, null)
            };

            if (available.Contains(PriceLens.RealDollars))
            {
                var cpi = Prices.GetObservations(Lens.CpiSeriesId);
                proj[PriceLens.RealDollars] = Lens.Apply(PriceLens.RealDollars, nominal, cpi);
                baseMonth = Lens.BaseMonth(cpi);
            }

            if (available.Contains(PriceLens.TimePrice))
            {
                var wages = Prices.GetObservations(Lens.WageSeriesId);
                proj[PriceLens.TimePrice] = Lens.Apply(PriceLens.TimePrice, nominal, wages);
                averageWage = wages.Where(o => o.Value is not null).LastOrDefault()?.Value;
            }

            projections = proj;

            var lastNominal = proj[PriceLens.Nominal].LastOrDefault();
            latestNominal = lastNominal?.Value;
            latestNominalDate = lastNominal?.Date;

            options = BuildOptions(lens, kind);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load series {SeriesId}.", Id);
            failed = true;
        }
    }
}
