@using PricePulse.Data
@inject PriceService Prices

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Price Pulse</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <RadzenIcon Icon="trending_up" class="series-icon" /> Dashboard
            </NavLink>
        </div>

        @if (series is not null)
        {
            @foreach (var s in series)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@($"series/{s.Id}")">
                        <SeriesIcon Icon="@s.Icon" /> @s.Name
                    </NavLink>
                </div>
            }
        }
    </nav>
</div>

@code {
    private IReadOnlyList<Series>? series;

    protected override async Task OnInitializedAsync()
    {
        series = await Prices.GetSeriesAsync();
    }
}
