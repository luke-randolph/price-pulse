@inject PriceService Prices
@inject NavigationManager Nav

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <RadzenIcon Icon="trending_up" class="brand-icon" /> Price Pulse
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        @if (series is not null)
        {
            @foreach (var group in series.GroupBy(s => s.Category))
            {
                <details class="nav-group" open="@group.Any(s => Nav.Uri.EndsWith(s.Id))">
                    <summary class="nav-group-title px-3 py-2 small text-uppercase fw-bold">
                        @group.Key.Label()
                    </summary>
                    @foreach (var s in group)
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="@($"series/{s.Id}")">
                                <SeriesIcon Icon="@s.Icon" /> @s.Name
                            </NavLink>
                        </div>
                    }
                </details>
            }
        }
    </nav>
</div>

@code {
    private IReadOnlyList<Series>? series;

    protected override void OnInitialized()
    {
        series = Prices.GetSeries();
    }
}
