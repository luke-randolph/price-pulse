@* "lucide:" prefix = a Lucide glyph via Blazicons; otherwise a Material Symbols glyph via Radzen. *@
@switch (Icon)
{
    case "lucide:milk":
        <Blazicon Svg="Lucide.Milk" class="series-icon" />
        break;
    case "lucide:banana":
        <Blazicon Svg="Lucide.Banana" class="series-icon" />
        break;
    case "lucide:drumstick":
        <Blazicon Svg="Lucide.Drumstick" class="series-icon" />
        break;
    default:
        <RadzenIcon Icon="@Icon" class="series-icon" />
        break;
}

@code {
    [Parameter]
    public string Icon { get; set; } = "";
}
