@page "/"
@using PricePulse.Fred
@inject FredClient Fred

<PageTitle>Home</PageTitle>

<h1>Cost of Living</h1>

@if (error is not null)
{
    <p style="color:red">Error: @error</p>
}
else if (points is null)
{
    <p>Loading…</p>
}
else
{
    var latest = points.LastOrDefault(p => p.Value is not null);
    <p>Loaded <strong>@points.Count</strong> observations for eggs (price per dozen).</p>
    @if (latest is not null)
    {
        <p>Most recent: <strong>@latest.Date</strong> = <strong>$@latest.Value</strong></p>
    }
}

@code {
    private IReadOnlyList<PricePoint>? points;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            points = await Fred.GetSeriesAsync("APU0000708111");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}
