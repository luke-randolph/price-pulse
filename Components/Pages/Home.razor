@page "/"
@using PricePulse.Data
@inject PriceService Prices

<PageTitle>Home</PageTitle>

<h1>Cost of Living</h1>

@if (error is not null)
{
    <p style="color:red">Error: @error</p>
}
else if (observations is null)
{
    <p>Loading…</p>
}
else
{
    var latest = observations.LastOrDefault(o => o.Value is not null);
    <p>Loaded <strong>@observations.Count</strong> observations for eggs (price per dozen).</p>
    @if (latest is not null)
    {
        <p>Most recent: <strong>@latest.Date</strong> = <strong>$@latest.Value</strong></p>
    }
}

@code {
    private IReadOnlyList<Observation>? observations;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            observations = await Prices.GetObservationsAsync("APU0000708111");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}
